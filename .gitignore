# Dependencies installed by pnpm.
node_modules/

# Build output from `pnpm build`; published to npm but never committed.
/lib/
/dist/

# Test and coverage reports generated locally.
/coverage/

# Packed release tarballs from `pnpm pack` or `npm pack`.
*.tgz

# Package-manager debug logs written on install or test failures.
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment files; .env.example documents the shape without secrets.
.env
.env.*
!.env.example

# OS metadata written by Finder and Windows Explorer.
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE state. .vs/ is Visual Studio's per-user cache and .idea/ is
# JetBrains' project state; neither belongs in the repository. .vscode/ is
# ignored because this project keeps no shared editor configuration.
.vs/
.idea/
.vscode/

# Browser-automation state left by patchright-cli during evaluation runs.
.patchright-cli/

# Local session memory and evaluation work products.
/.zcode/
/eval/*/patch-check/
/eval/*/sessions/
/*.log
*.tsbuildinfo
/eval/tools-render/render.json
