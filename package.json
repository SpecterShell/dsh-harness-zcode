{
  "name": "@spectershell/dsh-harness-zcode",
  "version": "0.1.0",
  "description": "ZCode agent preset for DeepSeek Harness",
  "type": "module",
  "license": "Apache-2.0",
  "author": "SpecterShell",
  "homepage": "https://github.com/SpecterShell/dsh-harness-zcode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpecterShell/dsh-harness-zcode.git"
  },
  "bugs": {
    "url": "https://github.com/SpecterShell/dsh-harness-zcode/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "zcode",
    "agent-preset",
    "cordis",
    "plugin"
  ],
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./tools": {
      "types": "./lib/tools/index.d.ts",
      "default": "./lib/tools/index.js"
    },
    "./context": {
      "types": "./lib/context/index.d.ts",
      "default": "./lib/context/index.js"
    },
    "./surface": {
      "types": "./lib/surface.d.ts",
      "default": "./lib/surface.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "NOTICE",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\" \"test/context/*.test.ts\" \"test/tools/*.test.ts\" \"test/integration/*.test.ts\" \"test/integration/*/*.test.ts\" \"test/pack/*.test.ts\"",
    "test:unit": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "test:proofs": "node --test --test-concurrency=1 \"test/integration/*.test.ts\" \"test/integration/*/*.test.ts\"",
    "test:pack": "node --test --test-concurrency=1 \"test/pack/*.test.ts\"",
    "prepack": "pnpm run build",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\""
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-fs": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.3 <0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
}
